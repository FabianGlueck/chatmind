{
  "name": "chatmind",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "cli": "pnpm --filter @chatmind/cli run start",
    "build": "pnpm --filter @chatmind/web build",
    "dev": "pnpm -r --parallel run dev",
    "start": "pnpm --filter @chatmind/server start"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "description": "Non-linear chat over an Obsidian vault",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabianGlueck/chatmind.git"
  }
}
